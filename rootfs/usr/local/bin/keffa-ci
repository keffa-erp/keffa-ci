#!/usr/bin/env python3
"""keffa-ci: the helper of the keffa-ci image.

  keffa-ci start           start MariaDB and the two Redis servers; wait until they answer
  keffa-ci stop            stop them
  keffa-ci status          say which of them answer
  keffa-ci site [APP ...]  print the baked site whose upstream apps are exactly APP ...; when
                           none is, install the missing apps on the closest smaller site and
                           print that one ("frappe" may be given or left out)
  keffa-ci info [--json]   the baked commits, versions, sites and passwords
  keffa-ci run [CMD ...]   start, then run CMD (the image's entrypoint; default bash)

Progress goes to stderr, so `SITE=$(keffa-ci site erpnext hrms)` captures the name only.
"""

import json
import os
import pwd
import shutil
import socket
import subprocess
import sys
import time
from typing import NoReturn

BENCH = os.environ.get("KEFFA_CI_BENCH", "/home/frappe/frappe-bench")
INFO = "/etc/keffa-ci/info.json"
LOGS = "/var/log/keffa-ci"
USER = "frappe"
DB_PORT = 3306
DB_ROOT_PASSWORD = "root"
REDIS = {"cache": 13000, "queue": 11000}
READY_TIMEOUT = 60.0


def say(*parts: object) -> None:
	print("keffa-ci:", *parts, file=sys.stderr, flush=True)


def fail(message: str) -> NoReturn:
	say(message)
	sys.exit(1)


def frappe_user() -> pwd.struct_passwd:
	return pwd.getpwnam(USER)


def drop_to_frappe() -> None:
	"""preexec_fn for services started as root: run them as the image user."""
	user = frappe_user()
	os.setgroups([])
	os.setgid(user.pw_gid)
	os.setuid(user.pw_uid)


def check_user() -> None:
	uid = os.getuid()
	if uid not in (0, frappe_user().pw_uid):
		fail(
			f"running as uid {uid}; the datadir and bench belong to {USER} (uid {frappe_user().pw_uid}). "
			"Run the container as that user (the default) or as root."
		)


def port_open(port: int) -> bool:
	with socket.socket() as s:
		s.settimeout(0.2)
		return s.connect_ex(("127.0.0.1", port)) == 0


def redis_ping(port: int) -> bool:
	try:
		with socket.create_connection(("127.0.0.1", port), timeout=0.5) as s:
			s.sendall(b"PING\r\n")
			return s.recv(16).startswith(b"+PONG")
	except OSError:
		return False


def db_ready() -> bool:
	# The listening port opens only after InnoDB has started, but ask a real question anyway.
	if not port_open(DB_PORT):
		return False
	return (
		subprocess.run(
			["mariadb-admin", "-uroot", f"-p{DB_ROOT_PASSWORD}", "-h127.0.0.1", "ping"],
			capture_output=True,
		).returncode
		== 0
	)


def status() -> dict[str, bool]:
	state = {"mariadb": db_ready()}
	for name, port in REDIS.items():
		state[f"redis-{name}"] = redis_ping(port)
	return state


def spawn(name: str, argv: list[str], as_frappe: bool) -> subprocess.Popen:
	log = open(os.path.join(LOGS, f"{name}.out"), "ab")
	return subprocess.Popen(
		argv,
		stdin=subprocess.DEVNULL,
		stdout=log,
		stderr=subprocess.STDOUT,
		start_new_session=True,
		preexec_fn=drop_to_frappe if as_frappe else None,
	)


def tail(path: str, lines: int = 20) -> str:
	try:
		with open(path, errors="replace") as f:
			return "".join(f.readlines()[-lines:])
	except OSError:
		return ""


def start(quiet: bool = False) -> None:
	check_user()
	began = time.monotonic()
	root = os.getuid() == 0
	if root:
		user = frappe_user()
		for path in ("/run/mysqld", LOGS):
			os.makedirs(path, exist_ok=True)
			os.chown(path, user.pw_uid, user.pw_gid)

	procs = {}
	if not port_open(DB_PORT):
		# mariadbd switches to `user = frappe` (99-keffa-ci.cnf) by itself when started as root.
		procs["mariadb"] = spawn("mariadb", ["/usr/sbin/mariadbd"], as_frappe=False)
	for name, port in REDIS.items():
		if not port_open(port):
			argv = [
				"redis-server",
				"--port", str(port),
				"--bind", "127.0.0.1",
				"--save", "",
				"--appendonly", "no",
				"--dir", "/tmp",
				"--logfile", os.path.join(LOGS, f"redis-{name}.log"),
			]  # fmt: skip
			procs[f"redis-{name}"] = spawn(f"redis-{name}", argv, as_frappe=root)

	deadline = began + READY_TIMEOUT
	while True:
		state = status()
		if all(state.values()):
			break
		for name, proc in procs.items():
			if proc.poll() is not None and not state.get(name):
				log = os.path.join(LOGS, "mariadb.log" if name == "mariadb" else f"{name}.log")
				fail(
					f"{name} exited with {proc.returncode}:\n{tail(log) or tail(os.path.join(LOGS, name + '.out'))}"
				)
		if time.monotonic() > deadline:
			fail(f"services not ready after {READY_TIMEOUT:.0f} s: {state}; logs in {LOGS}")
		time.sleep(0.05)
	if not quiet:
		what = "started" if procs else "already running"
		say(f"MariaDB and Redis {what}, ready in {time.monotonic() - began:.1f} s")


def stop() -> None:
	if port_open(DB_PORT):
		subprocess.run(
			["mariadb-admin", "-uroot", f"-p{DB_ROOT_PASSWORD}", "-h127.0.0.1", "shutdown"],
			check=True,
		)
	for port in REDIS.values():
		try:
			with socket.create_connection(("127.0.0.1", port), timeout=1) as s:
				s.sendall(b"SHUTDOWN NOSAVE\r\n")
				s.recv(16)
		except OSError:
			pass
	deadline = time.monotonic() + 60
	while any(port_open(p) for p in (DB_PORT, *REDIS.values())) or os.path.exists("/run/mysqld/mysqld.pid"):
		if time.monotonic() > deadline:
			fail("services still running after 60 s")
		time.sleep(0.1)
	say("MariaDB and Redis stopped")


def load_info() -> dict:
	with open(INFO) as f:
		return json.load(f)


def site_db(site: str) -> str:
	with open(os.path.join(BENCH, "sites", site, "site_config.json")) as f:
		return json.load(f)["db_name"]


def installed_apps(site: str) -> list[str]:
	"""The site's installed apps, read straight from its database (milliseconds, no bench)."""
	db = site_db(site)
	query = f"select defvalue from `{db}`.tabDefaultValue where parent='__global' and defkey='installed_apps'"
	out = subprocess.run(
		["mariadb", "-uroot", f"-p{DB_ROOT_PASSWORD}", "-h127.0.0.1", "-N", "-B", "-r", "-e", query],
		capture_output=True,
		text=True,
		check=True,
	).stdout.strip()
	return json.loads(out or "[]")


def bench_apps() -> list[str]:
	with open(os.path.join(BENCH, "sites", "apps.txt")) as f:
		return [line.strip() for line in f if line.strip()]


def site(apps: list[str]) -> None:
	wanted = []
	for app in apps:
		if app != "frappe" and app not in wanted:
			wanted.append(app)
	if not all(status().values()):
		start(quiet=True)

	sites = list(load_info()["sites"])
	current = {name: [a for a in installed_apps(name) if a != "frappe"] for name in sites}
	for name in sites:
		if set(current[name]) == set(wanted):
			print(name)
			return

	smaller = [name for name in sites if set(current[name]) < set(wanted)]
	if not smaller:
		fail(f"no baked site has a subset of {wanted}: {current}")
	best = max(smaller, key=lambda name: len(current[name]))
	missing = [app for app in wanted if app not in current[best]]
	absent = [app for app in missing if app not in bench_apps()]
	if absent:
		fail(f"{', '.join(absent)} not on the bench: `bench get-app` it first (in {BENCH})")
	say(f"installing {' '.join(missing)} on {best}")
	subprocess.run(
		["bench", "--site", best, "install-app", *missing],
		cwd=BENCH,
		stdout=sys.stderr,
		check=True,
	)
	print(best)


def info(as_json: bool) -> None:
	data = load_info()
	if as_json:
		print(json.dumps(data, indent=1))
		return
	print(f"keffa-ci {data['line']}, built {data['built']}")
	print(f"bench: {data['bench_path']} (bench CLI {data['versions']['bench']})")
	print("apps:")
	for name, app in data["apps"].items():
		print(f"  {name:10} {app['version']:12} {app['branch']:12} {app['commit']}")
	print("versions:")
	for name, version in data["versions"].items():
		print(f"  {name:12} {version}")
	print(
		"sites (admin password / MariaDB root password: "
		+ f"{data['admin_password']} / {data['db_root_password']}):"
	)
	for name, apps in data["sites"].items():
		print(f"  {name:34} {' '.join(['frappe', *apps])}")


def run(cmd: list[str]) -> None:
	start()
	cmd = cmd or ["bash"]
	path = shutil.which(cmd[0])
	if not path:
		fail(f"{cmd[0]}: command not found")
	os.execv(path, cmd)


def main(argv: list[str]) -> None:
	if not argv or argv[0] in ("-h", "--help", "help"):
		print(__doc__.strip())
		return
	command, args = argv[0], argv[1:]
	if command == "start":
		start()
	elif command == "stop":
		stop()
	elif command == "status":
		state = status()
		for name, up in state.items():
			print(f"{name:12} {'up' if up else 'down'}")
		sys.exit(0 if all(state.values()) else 1)
	elif command == "site":
		site(args)
	elif command == "info":
		info("--json" in args)
	elif command == "run":
		run(args)
	else:
		fail(f"unknown command {command!r}; see keffa-ci --help")


if __name__ == "__main__":
	main(sys.argv[1:])
