root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[{*.py,*.sh,Dockerfile,rootfs/usr/local/bin/keffa-ci,rootfs/usr/local/lib/keffa-ci/*}]
indent_style = tab
indent_size = 4
max_line_length = 110

[{*.yml,*.yaml,*.md}]
indent_style = space
indent_size = 2
